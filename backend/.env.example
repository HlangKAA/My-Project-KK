# ============================================================
# The Lost Spectrum - Backend Environment Template
# คัดลอกไฟล์นี้เป็น .env แล้วกรอกค่าจริงก่อนรันเซิร์ฟเวอร์
# ============================================================

# --- Flask App & Session ---
# คีย์ลับสำหรับเข้ารหัส session และ token ของ Flask
SECRET_KEY=

# URL ของฝั่ง Frontend ใช้สร้างลิงก์ยืนยันอีเมลและรีเซ็ตรหัสผ่าน (ค่าเริ่มต้น: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# --- Email Service (Gmail SMTP: smtp.gmail.com:587) ---
# อีเมลบัญชี Gmail ที่ใช้ส่งอีเมลยืนยันตัวตน / รีเซ็ตรหัสผ่าน
MAIL_USERNAME=
# App Password ของบัญชี Gmail (ไม่ใช่รหัสผ่านเข้าเมลปกติ)
MAIL_PASSWORD=
# ชื่อหรืออีเมลผู้ส่งเริ่มต้นที่จะแสดงในเมล
MAIL_DEFAULT_SENDER=

# --- Supabase Client ---
# Project URL ของ Supabase (เช่น https://xxxx.supabase.co)
SUPABASE_URL=
# API Key ของ Supabase (anon หรือ service_role key)
SUPABASE_KEY=

# --- PostgreSQL Database Connection ---
# วิธีที่ 1: ใส่ Connection String เต็มรูปแบบ (ถ้ากรอกตัวนี้ ระบบจะใช้ก่อนแบบแยกฟิลด์)
DATABASE_URL=
# หรือใช้ชื่อ SUPABASE_DB_URL แทนได้
# SUPABASE_DB_URL=

# วิธีที่ 2: กรอกแยกทีละฟิลด์ (ใช้เมื่อไม่ได้ตั้งค่า DATABASE_URL / SUPABASE_DB_URL)
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
